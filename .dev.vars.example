# Local development secrets. Copy to `.dev.vars` (read by both `next dev`
# via OpenNext and `wrangler dev`). Never commit `.dev.vars`.
#
# Bindings (D1 database, KV, Browser Rendering) are configured in
# wrangler.jsonc and simulated locally — no database URL needed.
#
#   npm install
#   npm run db:migrate:local     # create the local D1 tables
#   npm run dev                  # http://localhost:3000
#   open http://localhost:3000/api/dev/tick?all=1   # pull one round of data


# Cloudflare Turnstile secret. This is Cloudflare's documented test secret
# (always passes) — production uses the real secret via `wrangler secret put`.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Accounts (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated emails that become admins once verified (skip review).
ADMIN_EMAILS=
# Email (Cloudflare Email Service, `EMAIL` binding). Leave empty locally: mail goes to the dev outbox at
# http://localhost:3000/api/dev/mail instead.
EMAIL_FROM=

# Web Push (VAPID). Generate local keys with: npx tsx scripts/gen-vapid.ts --dev
# Production keys are generated ONCE and set with `wrangler secret put` —
# never rotate them casually (DEPLOY.md → Push notifications).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.com
