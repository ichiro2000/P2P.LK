# Build-time public settings (baked into the client bundle by `next build`).
# For a production build, copy to `.env.production` and fill in.
#
# Public site origin — used for canonical URLs, sitemap, OG images, emails.
NEXT_PUBLIC_SITE_URL=https://p2p.lk
# Cloudflare Turnstile SITE key (public) for p2p.lk. Leave empty locally to use
# Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
